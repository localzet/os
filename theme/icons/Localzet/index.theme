[Icon Theme]
Name=Localzet
Comment=Localzet Aurora first-party icons with Adwaita fallback
Inherits=Adwaita,hicolor
Example=localzet-settings
Directories=scalable/actions,scalable/apps,scalable/categories,scalable/devices,scalable/emblems,scalable/mimetypes,scalable/places,scalable/status

[scalable/actions]
Size=24
Type=Scalable
MinSize=16
MaxSize=256
Context=Actions

[scalable/apps]
