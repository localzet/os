# NOT ACTIVE. Calamares config alone cannot protect other disks.
---
efi:
  mountPoint: "/boot/efi"
  recommendedSize: 512MiB
  minimumSize: 300MiB
  label: "LOCALZET_EFI"
initialPartitioningChoice: none
initialSwapChoice: none
defaultPartitionTableType: gpt
defaultFileSystemType: "ext4"
lvm:
  enable: false
