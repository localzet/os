[Unit]
Description=Localzet disposable QEMU installation test
After=local-fs.target
ConditionKernelCommandLine=boot=casper
ConditionKernelCommandLine=localzet.install-test=1
ConditionVirtualization=kvm
[Service]
Type=oneshot
ExecStart=/usr/bin/unshare --mount --propagation private /bin/bash /usr/lib/localzet/vm-install-test.sh
TimeoutStartSec=900
StandardOutput=journal+console
StandardError=journal+console
[Install]
WantedBy=multi-user.target
